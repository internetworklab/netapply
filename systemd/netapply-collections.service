[Unit]
Description=NetApply Collection Manager Daemon
Documentation=https://github.com/internetworklab/netapply
Requires=network.target
After=network.target

[Service]
Type=simple
ExecStart=/root/go/bin/netapply serve-collection --bind-unix-socket /var/run/netapply-collections.sock --mongo-dburi=mongodb://localhost:27017
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netapply-collections

# Ensure the socket directory exists
RuntimeDirectory=netapply-collections
RuntimeDirectoryMode=0755

# Security settings (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

